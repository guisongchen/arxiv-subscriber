# Copy this to .env and fill in your values

# Notion integration (required)
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# Translation settings (optional)
# Get token from https://openrouter.ai/keys
TRANSLATE_API_TOKEN=your_openrouter_token_here
TRANSLATE_API_URL=https://openrouter.ai/api/v1
TRANSLATE_MODEL=google/gemini-2.5-flash

# Topic filtering (optional)
# Comma-separated keywords to filter papers (leave empty to get all)
TOPIC_KEYWORDS=diffusion,robotics,reinforcement learning,flow matching,VLA,world model,autonomous driving,self-driving
# Comma-separated keywords to exclude papers
EXCLUDE_KEYWORDS=survey,review,meta-analysis,benchmark,dataset,code,library,tool,framework,application,case study

# Fetch settings (optional)
# Number of papers to fetch per run (default: 300)
MAX_RESULTS=300

# Debug logging (optional)
# Set to "1" or "true" to enable verbose debug output with timestamps
DEBUG=0